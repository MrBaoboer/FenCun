# 氛寸 · 环境变量样例 —— 复制为 .env.local 后填入真实值（.env.local 已被 git 忽略）

# 和风天气 QWeather —— 实时天气（服务端调用，key 不落前端）
QWEATHER_HOST=your-qweather-api-host
QWEATHER_KEY=your-qweather-key

# DeepSeek —— 自然语言场景解析 + 有温度的解读
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash        # 可选；不填默认即 deepseek-v4-flash（DeepSeek 最新模型）

# LLM 日闸门 —— 每个函数实例生命周期内调用 DeepSeek 的上限，超过即全量降级到规则模板（见 src/lib/ratelimit.ts）。
# 注意它**不是**整站配额：计数是实例内存态，Serverless 冷启动即归零。单 IP 限流同样挡不住换 IP。
# 代码里这两道都只是纵深防御；真正的硬保险在 DeepSeek 控制台的账户消费上限。不填默认 3000。
LLM_DAILY_CAP=3000

# 天气日闸门 —— 同上，管的是和风那条路。它此前没有闸门，而它恰恰最容易被放大：
# 坐标按 0.01 步进就能保证每次都 miss 网格缓存，而一次 miss 要打两次和风（反查城市名 + 取实况）。
# 触顶后天气退回「季节 + 时段」降级链。不填默认 5000。
WEATHER_DAILY_CAP=5000

# 站点根地址 —— 只影响 OG 卡片 / canonical / sitemap 里的绝对 URL。
# 自部署到别的域名时才需要填；Vercel 预览环境会自动用它自己的域名，不必配。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
