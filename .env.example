# 复制为 .env.local。外部服务未配置时，应用会使用内置降级结果。

# 和风天气：服务端获取实时天气；Host 不含 https://
QWEATHER_HOST=your-qweather-api-host
QWEATHER_KEY=your-qweather-key

# DeepSeek：解析自然语言场景并转述规则结果
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 上游日调用上限，按函数实例计数，Serverless 冷启动即归零。它不是整站配额，也替代不了
# DeepSeek / 和风控制台上的账户消费上限——代码里这两道只是纵深防御。
LLM_DAILY_CAP=3000          # 触顶后解读全量降级到规则模板。不填默认 3000
# 天气这条更容易被放大：坐标按 0.01 步进就能每次都 miss 网格缓存，而一次 miss 要打两次和风
# （反查城市名 + 取实况）。触顶后天气退回「季节 + 时段」降级链。
# 默认 800 卡的是免费额度：和风给 5 万次/月，而天气与 GeoAPI 共用这一份，摊到每天约 1600 次。
# 原来的 5000 意味着不到十天就烧穿全月免费额度，之后按 0.0007 元/次计费。
WEATHER_DAILY_CAP=800       # 不填默认 800

# 自部署域名；用于 canonical、sitemap 和分享卡片的绝对 URL
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
