# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# raw perfume dataset (too large for git — ~636MB; only the built static JSON in public/data is committed)
/ledecanteur/

# scratch
/.scratch/
# 临时探针脚本（排查引擎行为时用 node --import tsx 直接跑纯函数最可靠，收工即删）。
# 它们不该进仓库：eslint 会照扫根目录，一个临时 .ts 里的 no-explicit-any 就是 error，
# 一次 `git add -A` 足以把 CI 的 lint 门禁打红。
/*-probe.*
/.*-probe.*
/probe-*.*

.vercel
.env*
!.env.example
